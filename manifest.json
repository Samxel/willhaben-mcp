{
  "manifest_version": "0.4",
  "name": "willhaben-mcp",
  "display_name": "willhaben",
  "version": "1.0.0",
  "description": "Search willhaben.at: the marketplace, used cars and real estate, with full ad details, photos and sellers.",
  "long_description": "Searches the willhaben.at marketplace, used cars (Auto & Motor) and real estate (Immobilien) with categories, brands, makes and models, states and districts, filters out accessories and wrong variants server-side, and reads full ads, their photos and the seller. Unofficial; uses the willhaben app API.",
  "author": {
    "name": "Samxel",
    "url": "https://github.com/Samxel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samxel/willhaben-mcp"
  },
  "homepage": "https://github.com/Samxel/willhaben-mcp",
  "support": "https://github.com/Samxel/willhaben-mcp/issues",
  "server": {
    "type": "uv",
    "entry_point": "main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "main.py",
        "--stdio"
      ]
    }
  },
  "tools": [
    {
      "name": "search_willhaben",
      "description": "Search the marketplace, with filters run server-side"
    },
    {
      "name": "get_ad_detail",
      "description": "One ad or several in full"
    },
    {
      "name": "get_ad_images",
      "description": "An ad's photos"
    },
    {
      "name": "get_ad_seller",
      "description": "Who sells an ad"
    },
    {
      "name": "list_categories",
      "description": "Category ids by name"
    },
    {
      "name": "search_brands",
      "description": "Brand ids for a category"
    },
    {
      "name": "search_autos",
      "description": "Search used cars"
    },
    {
      "name": "list_car_makes",
      "description": "Car make ids"
    },
    {
      "name": "list_car_models",
      "description": "The models of a car make"
    },
    {
      "name": "search_immobilien",
      "description": "Search real estate"
    },
    {
      "name": "list_immobilien_types",
      "description": "Property types"
    }
  ],
  "keywords": [
    "willhaben",
    "classifieds",
    "austria",
    "immobilien",
    "gebrauchtwagen"
  ],
  "license": "MIT",
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
